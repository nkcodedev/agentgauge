{
  "name": "agentgauge",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "Observability and cost intelligence for AI agents",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:boundaries",
    "db:migrate": "pnpm --filter @agentgauge/db migrate",
    "db:seed": "pnpm --filter @agentgauge/db seed",
    "dev:seed": "pnpm db:seed",
    "dev:seed-demo": "pnpm --filter @agentgauge/api seed-demo",
    "dev:create-api-key": "pnpm --filter @agentgauge/api create-api-key",
    "dev:api": "pnpm --filter @agentgauge/api dev",
    "dev:worker": "pnpm --filter @agentgauge/worker dev",
    "dev:dashboard": "pnpm --filter @agentgauge/dashboard dev",
    "dev": "pnpm --filter @agentgauge/api --filter @agentgauge/worker --filter @agentgauge/dashboard --parallel dev",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  }
}
