# AgentGauge local development — placeholders only. Never commit real secrets.

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://agentgauge:agentgauge@localhost:5432/agentgauge

# Optional pepper mixed into API-key hashes (empty string is acceptable for local only)
AGENTGAUGE_API_KEY_PEPPER=

# API server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Worker
WORKER_POLL_MS=2000
WORKER_BATCH_SIZE=100

# Dashboard local environment (server-side only)
# AGENTGAUGE_API_URL=http://127.0.0.1:3000
# AGENTGAUGE_API_KEY=
